# Copy to .env. Never commit .env. No secrets belong in this file.

# Postgres (docker compose)
POSTGRES_USER=receptio
POSTGRES_PASSWORD=receptio
POSTGRES_DB=receptio

# Clinic backend
DATABASE_URL=postgresql+psycopg://receptio:receptio@localhost:5432/receptio
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Agent -> clinic backend
BACKEND_URL=http://localhost:8000
BACKEND_TIMEOUT_SECONDS=5

# LiveKit (voice). These are LiveKit's documented --dev credentials: not secrets, local only.
# Replace both before any non-local deployment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# One JSON line per Caller turn; summarise with scripts/latency_summary.
# TURN_LOG_PATH=logs/voice-turns.jsonl
# MIN_ENDPOINTING_DELAY=0.5

# Provider keys: not needed for text mode. Add real values only in your local .env (ticket 12+).
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5
# LLM_MODEL_FAST=claude-haiku-5-5
# LLM_TIMEOUT_SECONDS=15

# Cost guard (ticket 13). The defaults are the specified caps: a Call lasts at most 5 minutes with
# a warning at 4:30; 3 Calls per visitor (browser + IP) per day; 120 minutes per day overall.
# CALL_MAX_SECONDS is read by the backend and the agent: set it once for both.
# CALL_MAX_SECONDS=300
# CALL_WARNING_SECONDS=270
# VISITOR_CALLS_PER_DAY=3
# IP_CALLS_PER_DAY=10
# GLOBAL_MINUTES_PER_DAY=120
# Reverse proxies of yours in front of the web service; 0 ignores X-Forwarded-For entirely.
# TRUSTED_PROXY_HOPS=0
# Lifts the daily caps for the local load test. Off by default, and the backend refuses to start
# with it on while DEPLOYED_ENVIRONMENT=true. Never turn it on in the public demo.
CAPS_TEST_MODE=false
# Set to true in every deployed environment (the public demo). The backend then refuses to start
# with the Postgres password "receptio" (or a missing, postgres-superuser or other weak one) or
# DEMO_CONTROLS_ENABLED, and the web service and voice worker refuse LiveKit's dev keys
# (devkey/secret) or a LIVEKIT_API_SECRET under 32 characters.
DEPLOYED_ENVIRONMENT=false

# Rate limits (ticket 20), in process, per client address. POST /token (web service): requests per
# minute per IP. Capacity admission (backend): the backstop behind it. Identification (name +
# phone) attempts: FAILURES in the window lock a name, a phone, or everyone out. Same
# TRUSTED_PROXY_HOPS rules as the cost guard.
# TOKEN_REQUESTS_PER_MINUTE_PER_IP=10
# ADMISSION_REQUESTS_PER_MINUTE_PER_IP=30
# IDENTITY_FAILURE_WINDOW_SECONDS=600
# IDENTITY_FAILURES_PER_NAME=5
# IDENTITY_FAILURES_PER_PHONE=5
# IDENTITY_FAILURES_GLOBAL=30

# Alerts (python -m backend.app.alerts): evaluated over the last ALERT_WINDOW_MINUTES of stored
# Calls; a rule needs its minimum sample before it can fire. Latency is end of Caller speech to
# first agent audio; defaults are the targets in docs/metrics.md.
# ALERT_WINDOW_MINUTES=15
# ALERT_LATENCY_P50_MS=800
# ALERT_LATENCY_P95_MS=1500
# ALERT_MIN_TURNS=10
# ALERT_TOOL_FAILURE_RATE=0.2
# ALERT_MIN_TOOL_CALLS=10
# ALERT_DROPPED_CALL_RATE=0.5
# ALERT_MIN_CALLS=10

# Demo-only: exposes the Clinic Hours open/closed override. Never enable in a public deployment.
DEMO_CONTROLS_ENABLED=false

# Per-Call cost stored by the backend (backend/app/cost.py). Prices are configuration; the defaults in
# backend/app/config.py are PLACEHOLDERS and a Call's cost says so until these are set.
# LLM_PRICES_PER_MTOK={"claude-sonnet-5-5": [3.0, 15.0], "claude-haiku-5-5": [1.0, 5.0]}
# DEEPGRAM_USD_PER_MINUTE=
# CARTESIA_USD_PER_1K_CHARACTERS=

# Eval harness (python -m evals). Real runs are opt-in: --mode simulated needs ANTHROPIC_API_KEY
# in the environment. Prices below are USD per million tokens; the defaults in evals/config.py are
# PLACEHOLDERS. Set them from the provider's price list for real cost numbers.
# EVAL_SIM_MODEL=claude-haiku-5-5
# EVAL_PRICE_MAIN_INPUT_PER_MTOK=
# EVAL_PRICE_MAIN_OUTPUT_PER_MTOK=
# EVAL_PRICE_FAST_INPUT_PER_MTOK=
# EVAL_PRICE_FAST_OUTPUT_PER_MTOK=
# EVAL_MAX_REQUESTS=150
# EVAL_MAX_COST_USD=1.0
